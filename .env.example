# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://notifyhub:notifyhub_dev_pw@localhost:5432/notifyhub_dev?schema=public"

# Symmetric secret used to sign/verify access tokens. Generate with:
#   openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN="http://localhost:3000"

# APNs device push (see docs/project-memory/07-decisions.md ADR-008).
# All four must be set for the APNs channel to send anything - if any are
# missing it silently no-ops. NEVER set these in this repo's CI or commit
# real values here: generate a real .p8 key + Key ID in the Apple Developer
# portal and set these only in a local/operator environment.
# APNS_KEY_ID="ABCD123456"
# APNS_TEAM_ID="TEAM123456"
# APNS_BUNDLE_ID="com.example.notifyhub-ios"
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_ENVIRONMENT="sandbox"   # or "production"; defaults to sandbox
